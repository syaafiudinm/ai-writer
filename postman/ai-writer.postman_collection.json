    {
      "name": "Skenario: rate limit login",
      "description": "Satu request yang diulang 6 kali otomatis (hanya di Collection Runner / newman). Percobaan 1–5 → 401, ke-6 → 429 + `Retry-After`, dan tercatat di `audit_logs` sebagai `login_rate_limited`. Email dibuat unik per run agar tidak mengunci akun asli.\n\nJika dijalankan manual dengan tombol Send, klik 6 kali.",
      "item": [
        {
          "name": "Login gagal berulang",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Requested-With",
                "value": "fetch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{rlEmail}}\",\n  \"password\": \"password-salah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let n = Number(pm.collectionVariables.get(\"rlAttempt\") || 0) + 1;",
                  "if (n === 1 || n > 6) {",
                  "  n = 1;",
                  "  pm.collectionVariables.set(\"rlEmail\", `ratelimit-${Date.now()}@contoh.com`);",
                  "}",
                  "pm.collectionVariables.set(\"rlAttempt\", n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get(\"rlAttempt\"));",
                  "if (n <= 5) {",
                  "  pm.test(`percobaan ${n} → 401`, () => pm.response.to.have.status(401));",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test(\"percobaan 6 → 429\", () => pm.response.to.have.status(429));",
                  "  pm.test(\"ada Retry-After\", () => pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.above(0));",
                  "  pm.collectionVariables.set(\"rlAttempt\", 0);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
