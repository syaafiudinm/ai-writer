                  "const b = pm.response.json();",
                  "pm.test(\"balas id, name, role\", () => pm.expect(b).to.include.keys(\"id\", \"name\", \"role\"));",
                  "pm.test(\"cookie sesi di-set\", () => pm.expect(pm.cookies.has(\"session\")).to.be.true);",
