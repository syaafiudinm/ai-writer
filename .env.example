# Salin ke .env lalu isi. Jangan pernah commit .env.

# --- Wajib ---
# API key dari https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
DATABASE_URL=postgres://app:pass@localhost:5433/aiwriter?sslmode=disable

# --- Opsional (nilai di bawah = default, kecuali yang ditandai) ---
GEMINI_MODEL=gemini-3.5-flash
# minimal = tanpa thinking (TTFT tercepat, tidak memakan jatah token). Nilai lain
# (low/medium/high) menambah ruang 8192 token untuk thinking. Dukungan per model berbeda:
# gemini-3.8-flash menolak "minimal".
GEMINI_THINKING_LEVEL=minimal
# Harga USD per juta token, untuk estimasi biaya di dashboard admin (default kosong = 0)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PORT=8080
SESSION_TTL=168h
# Default true; set false hanya di localhost (http)
COOKIE_SECURE=false
RATE_LIMIT_PER_MIN=10
GENERATE_TIMEOUT=180s
LOG_RETENTION_DAYS=180
# Path build React, mis. ./web/dist (kosong = tidak menyajikan frontend)
STATIC_DIR=
# Hanya jika frontend beda domain
ALLOWED_ORIGIN=
# true jika di belakang reverse proxy (Caddy/Nginx/Railway)
TRUST_PROXY=false
# Jumlah proxy tepercaya di depan app; IP klien = entri ke-N dari kanan X-Forwarded-For.
# Caddy/Nginx di VPS = 1, Railway = 2 (edge + proxy internal)
TRUST_PROXY_HOPS=1
# Sementara saja: catat header proxy mentah di log untuk memastikan TRUST_PROXY_HOPS
LOG_PROXY_HEADERS=false
# Zona waktu pembagian hari di dashboard admin (WIB: Asia/Jakarta, WITA: Asia/Makassar, WIT: Asia/Jayapura)
TIMEZONE=Asia/Makassar
