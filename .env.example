# Salin ke .env lalu isi. Jangan pernah commit .env.

# --- Wajib ---
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://app:pass@localhost:5433/aiwriter?sslmode=disable

# --- Opsional (nilai di bawah = default, kecuali yang ditandai) ---
ANTHROPIC_MODEL=claude-sonnet-5-5
# Harga USD per juta token, untuk estimasi biaya di dashboard admin (default kosong = 0)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PORT=8080
SESSION_TTL=168h
# Default true; set false hanya di localhost (http)
COOKIE_SECURE=false
RATE_LIMIT_PER_MIN=10
GENERATE_TIMEOUT=180s
LOG_RETENTION_DAYS=180
# Path build React, mis. ./web/dist (kosong = tidak menyajikan frontend)
STATIC_DIR=
# Hanya jika frontend beda domain
ALLOWED_ORIGIN=
# true jika di belakang Nginx/Cloud Run
TRUST_PROXY=false
